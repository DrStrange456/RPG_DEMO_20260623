[sub_resource type="GDScript" id="GDScript_d8s5b"]
script/source = "extends CharacterBody2D

@export var move_speed: float = 60.0
@export var detection_range: float = 200.0
@export var target: Node2D

@onready var anim: AnimationPlayer = $AnimationPlayer
@onready var detect_area: Area2D = $Area2D

enum State {
	SLEEP,
	ARISING,
	CHASE
}

var state: State = State.SLEEP
var player: Node2D = null


func _ready():
	detect_area.body_entered.connect(_on_body_entered)
	detect_area.body_exited.connect(_on_body_exited)
	anim.animation_finished.connect(_on_animation_player_animation_finished)
	
	# start asleep visually
	anim.play(\"idle_sleep\")


# -----------------------
# STATE MACHINE UPDATE
# -----------------------
func _physics_process(delta):
	match state:
		State.SLEEP:
			velocity = Vector2.ZERO

		State.ARISING:
			velocity = Vector2.ZERO

		State.CHASE:
			_chase_player(delta)

	move_and_slide()


# -----------------------
# CHASE LOGIC
# -----------------------
func _chase_player(_delta):
	if player == null:
		state = State.SLEEP
		return

	var dir: Vector2 = (player.global_position - global_position).normalized()
	velocity = dir * move_speed

	_play_walk_animation(dir)


# -----------------------
# ANIMATION CONTROL
# -----------------------
func _play_walk_animation(dir: Vector2):
	if abs(dir.x) > abs(dir.y):
		if dir.x > 0:
			anim.play(\"walk_right\")
		else:
			anim.play(\"walk_left\")
	else:
		if dir.y > 0:
			anim.play(\"walk_down\")
		else:
			anim.play(\"walk_up\")


# -----------------------
# DETECTION
# -----------------------
func _on_body_entered(body):
	if body.is_in_group(\"player\"):
		player = body
		
		if state == State.SLEEP:
			state = State.ARISING
			anim.play(\"arise\")


func _on_body_exited(body):
	if body == player:
		player = null
		state = State.SLEEP
		anim.play(\"idle_sleep\")


func _on_animation_player_animation_finished(anim_name):
	if anim_name == \"arise\":
		state = State.CHASE
"

